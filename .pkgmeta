# BigWigs packager metadata.
#
# This is the file CurseForge, Wago and WoWInterface build from. It packages
# the MoltenCodes framework as the standalone addon "MoltenCodes": every
# release Kit, loaded by a MoltenCodes.toc that is generated rather than
# committed. The release workflow writes that .toc into its checkout with
# `python3 -m tooling.release.library_toc` just before the packager runs; it
# lists every release Kit in load order. Installing the addon gives a player
# every Kit once; addons may still embed Kits instead, and Registry keeps one
# copy of each whichever way it arrived. See docs/EMBEDDING.md.
#
# The packaged layout follows the one `python3 -m tooling.package.build`
# produces locally, so what a release publishes and what a contributor can
# build and checksum on their own machine agree on every Lua file and on the
# .toc:
#
#     MoltenCodes/
#     ├── LICENSE
#     ├── MoltenCodes.toc
#     ├── registry/Registry.lua
#     ├── registry/docs/API.md
#     ├── signalKit/SignalKit.lua
#     └── ...
#
# One difference is deliberate: the packager moves directories, not files, so a
# package's README.md and CHANGELOG.md are left out of the packager zip and ship
# only in the builder bundle attached to the GitHub release. Each package's
# docs/ directory travels with its Lua file.
#
# A package tag (`<packageId>-v<version>`) releases one Kit as the addon
# "MoltenCodes-<Facade>". Its metadata is derived from this file by
# `python3 -m tooling.release.pkgmeta --package <packageId>`, which narrows
# `ignore` and `move-folders` to that Kit and the Kits it requires, so this
# file stays the only one maintained by hand.
#
# See docs/RELEASES.md for tags, artifacts and checksums.

package-as: MoltenCodes

# The generated .toc carries one comma-separated `## Interface` line for every
# supported client, so no per-flavour .toc files are generated. There are no
# `externals`, so there is no library to strip for a "nolib" variant.
enable-toc-creation: no
enable-nolib-creation: no

license-output: LICENSE

# Everything that exists for development rather than for the game client. A
# package's `metadata/` (the normalised API tables apiKit is generated from)
# and `types/` (LuaCATS definitions for editors) are development data too.
ignore:
  - packages/testKit
  - .busted
  - .editorconfig
  - .gitattributes
  - .github
  - .gitignore
  - .luarc.json
  - .vscode
  - busted.yml
  - cspell.json
  - docs
  - examples
  - meta
  - pyproject.toml
  - selene.toml
  - selene-tests.toml
  - tests
  - stylua.toml
  - tooling
  - packages/README.md
  - packages/*/README.md
  - packages/*/CHANGELOG.md
  - packages/*/tests
  - packages/*/package.manifest.json
  - packages/*/src/.luarc.json
  - packages/*/metadata
  - packages/*/types
  - packages/*/docs/changes
  - packages/*/docs/reference

# Flatten each package's development layout into the one an addon embeds.
# A package directory is named by its lowerCamelCase package ID; the Lua file
# inside it keeps its PascalCase facade name.
move-folders:
  MoltenCodes/packages/registry/src: MoltenCodes/registry
  MoltenCodes/packages/registry/docs: MoltenCodes/registry/docs
  MoltenCodes/packages/signalKit/src: MoltenCodes/signalKit
  MoltenCodes/packages/signalKit/docs: MoltenCodes/signalKit/docs
  MoltenCodes/packages/eventKit/src: MoltenCodes/eventKit
  MoltenCodes/packages/eventKit/docs: MoltenCodes/eventKit/docs
  MoltenCodes/packages/lifecycleKit/src: MoltenCodes/lifecycleKit
  MoltenCodes/packages/lifecycleKit/docs: MoltenCodes/lifecycleKit/docs
  MoltenCodes/packages/moduleKit/src: MoltenCodes/moduleKit
  MoltenCodes/packages/moduleKit/docs: MoltenCodes/moduleKit/docs
  MoltenCodes/packages/timerKit/src: MoltenCodes/timerKit
  MoltenCodes/packages/timerKit/docs: MoltenCodes/timerKit/docs
  MoltenCodes/packages/schedulerKit/src: MoltenCodes/schedulerKit
  MoltenCodes/packages/schedulerKit/docs: MoltenCodes/schedulerKit/docs
  MoltenCodes/packages/poolKit/src: MoltenCodes/poolKit
  MoltenCodes/packages/poolKit/docs: MoltenCodes/poolKit/docs
  MoltenCodes/packages/clientKit/src: MoltenCodes/clientKit
  MoltenCodes/packages/clientKit/docs: MoltenCodes/clientKit/docs
  MoltenCodes/packages/cacheKit/src: MoltenCodes/cacheKit
  MoltenCodes/packages/cacheKit/docs: MoltenCodes/cacheKit/docs
  MoltenCodes/packages/profileKit/src: MoltenCodes/profileKit
  MoltenCodes/packages/profileKit/docs: MoltenCodes/profileKit/docs
  MoltenCodes/packages/readinessKit/src: MoltenCodes/readinessKit
  MoltenCodes/packages/readinessKit/docs: MoltenCodes/readinessKit/docs
  MoltenCodes/packages/schemaKit/src: MoltenCodes/schemaKit
  MoltenCodes/packages/schemaKit/docs: MoltenCodes/schemaKit/docs
  MoltenCodes/packages/localeKit/src: MoltenCodes/localeKit
  MoltenCodes/packages/localeKit/docs: MoltenCodes/localeKit/docs
  MoltenCodes/packages/hookKit/src: MoltenCodes/hookKit
  MoltenCodes/packages/hookKit/docs: MoltenCodes/hookKit/docs
  MoltenCodes/packages/settingsKit/src: MoltenCodes/settingsKit
  MoltenCodes/packages/settingsKit/docs: MoltenCodes/settingsKit/docs
  MoltenCodes/packages/optionsKit/src: MoltenCodes/optionsKit
