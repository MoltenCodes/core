{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate repository",
      "type": "shell",
      "command": "python3 -m tooling.validation.validate_repository",
      "problemMatcher": []
    },
    {
      "label": "Run all Lua tests",
      "type": "shell",
      "command": "python3 -m tooling.test.run",
      "problemMatcher": []
    },
    {
      "label": "Measure Lua line coverage",
      "type": "shell",
      "command": "python3 -m tooling.test.coverage",
      "problemMatcher": []
    },
    {
      "label": "Run Registry tests",
      "type": "shell",
      "command": "python3 -m tooling.test.run registry",
      "problemMatcher": []
    },
    {
      "label": "Run example addon tests",
      "type": "shell",
      "command": "python3 -m tooling.test.run examples",
      "problemMatcher": []
    },
    {
      "label": "Run tooling unit tests",
      "type": "shell",
      "command": "python3 -m unittest discover -s tooling/tests -p \"test_*.py\"",
      "problemMatcher": []
    },
    {
      "label": "Check generated apiKit outputs",
      "type": "shell",
      "command": "python3 -m tooling.api.generate --all --check",
      "problemMatcher": []
    },
    {
      "label": "Lint Lua (runtime and tests)",
      "type": "shell",
      "command": "python3 -m tooling.lint",
      "problemMatcher": []
    },
    {
      "label": "Check Lua formatting",
      "type": "shell",
      "command": "stylua --check .",
      "problemMatcher": []
    }
  ]
}
